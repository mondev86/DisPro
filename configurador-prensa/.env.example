# ============================================================
# .env.example (raíz) — variables de entorno para docker-compose
# Copia este archivo a .env y rellena los valores reales.
#   `cp .env.example .env`  (Linux/macOS/Git Bash)
#   `Copy-Item .env.example .env`  (PowerShell)
# ============================================================

# URL de conexión a PostgreSQL (usada por backend, Docker y Prisma)
DATABASE_URL=postgresql://prensa:prensa_dev_password@localhost:5432/configurador_prensa?schema=public

# Secreto para firmar tokens JWT. ¡Cámbialo en producción!
# Puedes generarlo con: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change_me_cambia_este_secreto_en_produccion

# Puerto del servidor HTTP + WebSocket del backend
PORT=4000

# URL del frontend (usada para CORS / conexiones Socket.io-cross-origin)
FRONTEND_URL=http://localhost:5173

# --- Variables para docker-compose (infraestructura) ---
POSTGRES_DB=configurador_prensa
POSTGRES_USER=prensa
POSTGRES_PASSWORD=prensa_dev_password
POSTGRES_PORT=5432