# ============================================================
# .env.example (backend) — variables de entorno del servidor
# Copia este archivo a .env dentro de backend/ para desarrollo local.
# ============================================================

# URL de PostgreSQL. En Docker usa el host "db"; en local usa "localhost".
DATABASE_URL=postgresql://prensa:prensa_dev_password@localhost:5432/configurador_prensa?schema=public

# Secreto JWT (firma de tokens). Cámbialo. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_cambia_este_secreto_en_produccion

# Puerto HTTP de la API + WebSocket
PORT=4000

# Origen permitido por CORS (el frontend de Vite en desarrollo)
FRONTEND_URL=http://localhost:5173