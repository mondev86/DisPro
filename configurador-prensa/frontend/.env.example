# ============================================================
# .env.example (frontend) — variables de entorno del cliente
# ============================================================

# En desarrollo no hace falta: el proxy de Vite (vite.config.js)
# reenvía /api y /socket.io al backend local.
#
# En producción (docker-compose + nginx) tampoco hace falta,
# porque nginx proxifica las mismas rutas.
#
# Solo necesitas definir VITE_API_URL si sirves el frontend desde
# un dominio distinto al backend y NO usas proxy.

# VITE_API_URL=http://localhost:4000
# VITE_WS_URL=ws://localhost:4000